{
  "name": "gradex-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:clean": "rm -rf .next && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "legal:generate": "node scripts/generate-legal-content.mjs",
    "legal:check": "node scripts/generate-legal-content.mjs --check",
    "test": "npm run legal:check && rm -rf ../.frontend-test-build && tsc -p tsconfig.test.json && node --test \"../.frontend-test-build/**/*.test.js\"",
    "test:s2-ui": "node scripts/verify-s2-taxonomy-ui.mjs",
    "test:e2e": "playwright test",
    "test:e2e:canonical": "node scripts/e2e-canonical.mjs",
    "test:e2e:development": "playwright test",
    "test:e2e:production": "GRADEX_E2E_FRONTEND_MODE=production playwright test",
    "test:e2e:release": "playwright test e2e/s11-release-acceptance.spec.ts --workers=1",
    "test:e2e:media-authoring": "playwright test --config=playwright.media-authoring.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "hls.js": "1.6.15",
    "lucide-react": "^0.417.0",
    "next": "15.5.21",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.62.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.21",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.0"
  }
}
