{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": false,
    "incremental": false,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "../.frontend-test-build",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src/lib/identity/**/*.ts", "src/lib/formatters/**/*.ts", "src/lib/api/**/*.ts"],
  "exclude": ["node_modules"]
}
