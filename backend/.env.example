# Gradex backend configuration.
#
# Two layers, deliberately separate (design §11.2):
#   - non-secret settings, safe to commit as this example and to log;
#   - secrets, which in production are resolved through the approved secret
#     manager rather than from a file like this one.
#
# The names below are the authoritative list. internal/config rejects a
# production deployment that leaves a required one unset, and rejects keys it
# no longer reads rather than silently falling back to a default.

# --- Environment -------------------------------------------------------------
# development | staging | production
APP_ENV=development
PORT=8080

# Required when APP_ENV=production, and must be https there.
PUBLIC_ORIGIN=http://localhost:3000

# Comma-separated. Defaults to empty, which denies. "*" is rejected in
# production, and rejected everywhere when credentials are allowed.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# Comma-separated proxy CIDRs whose forwarding headers may be believed.
# Empty means trust none, which is the default. Do not widen this without a
# real proxy in front: trusting every proxy lets any client forge its address.
TRUSTED_PROXIES=

# debug | info | warn | error
LOG_LEVEL=info

# api | worker. Determines readiness policy: which dependencies this process
# genuinely needs in order to serve its responsibilities.
SERVICE_ROLE=api

# Whole-evaluation budget for a /readyz probe. Keep it below the orchestrator's
# probe timeout so a hung dependency fails the probe rather than the check.
READINESS_TIMEOUT=2s

# --- Timeouts (Go durations) -------------------------------------------------
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=20s

# Role-specific server-authoritative session windows. Idle must be strictly
# less than absolute for every role.
STUDENT_SESSION_IDLE_EXPIRY=168h
STUDENT_SESSION_ABSOLUTE_EXPIRY=720h
INSTRUCTOR_SESSION_IDLE_EXPIRY=1h
INSTRUCTOR_SESSION_ABSOLUTE_EXPIRY=24h
ADMIN_SESSION_IDLE_EXPIRY=30m
ADMIN_SESSION_ABSOLUTE_EXPIRY=12h
GENERAL_RECENT_AUTH_WINDOW=10m
HIGHEST_RISK_RECENT_AUTH_WINDOW=5m
SESSION_STALE_USE_WINDOW=5s

# --- Infrastructure ----------------------------------------------------------
REDIS_ADDR=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS_ENABLED=false
REDIS_TLS_SERVER_NAME=
# Optional PEM CA bundle mounted into the API and worker containers.
REDIS_TLS_CA_CERT_FILE=

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=gradex-video
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true

# --- Media pipeline ----------------------------------------------------------
# Durations, not minute counts. The former *_MINUTES names are now rejected.
UPLOAD_URL_EXPIRY=15m
PLAYBACK_URL_EXPIRY=5m
MAX_UPLOAD_SIZE_BYTES=5368709120

FFMPEG_BINARY_PATH=ffmpeg
FFPROBE_BINARY_PATH=ffprobe

# --- Gated providers ---------------------------------------------------------
# Disabled by default. An absent secret disables only that provider surface;
# unrelated traffic continues. Live Tap without an approved LG-010 adapter
# contract blocks startup outright rather than starting unable to take money.
TAP_ENABLED=false
TAP_ENVIRONMENT=test
TAP_ADAPTER_APPROVED=false

EMAIL_ENABLED=false
EMAIL_PROVIDER=fake
EMAIL_FROM_ADDRESS=no-reply@gradex.test
EMAIL_FROM_NAME=Gradex
EMAIL_REPLY_TO=
EMAIL_PROVIDER_TIMEOUT=10s

# --- Student admission (fail closed) ----------------------------------------
# Public registration remains disabled until every setting/secret below is
# explicit. The deterministic password source and dev policy ID are local
# fixtures only; production rejects them and requires LG-011/LG-021 approval.
STUDENT_REGISTRATION_ENABLED=false
REGISTRATION_POLICY_SET_ID=dev-registration-v1
REGISTRATION_POLICY_APPROVED=false
PASSWORD_SCREEN_MODE=deterministic
COMPROMISED_PASSWORD_ADAPTER_APPROVED=false

ANONYMOUS_SESSION_TTL=30m
VERIFICATION_TOKEN_TTL=24h
ADMISSION_RATE_LIMIT_TIMEOUT=100ms
COMPROMISED_PASSWORD_TIMEOUT=3s
OUTBOX_PROTECTED_PAYLOAD_KEY_VERSION=dev-v1

# --- Development-only seam ---------------------------------------------------
# Rejected when APP_ENV=production.
AUTH_FAKE_MODE=true

# --- Secrets -----------------------------------------------------------------
# Resolved through internal/config's SecretResolver. Values here are for local
# development only; production resolves the same names from the secret manager.
DATABASE_URL=postgres://gradex:gradex@localhost:5432/gradex?sslmode=disable
S3_ACCESS_KEY=gradexminio
S3_SECRET_KEY=gradexminio

# Generate with: openssl rand -hex 32
# The "changeme" placeholder is rejected when APP_ENV=production.
PLAYBACK_TOKEN_SECRET=changeme-generate-with-openssl-rand-hex-32
SESSION_CSRF_KEY=changeme-generate-with-openssl-rand-hex-32

# Only needed when the matching provider is enabled above.
# TAP_SECRET=
# EMAIL_API_KEY= # Required only for EMAIL_PROVIDER=resend.

# Required only when STUDENT_REGISTRATION_ENABLED=true. These example values
# are intentionally absent: generate independent keys for each purpose.
# ANONYMOUS_COOKIE_SIGNING_KEY=
# ANONYMOUS_CSRF_KEY=
# ADMISSION_LIMITER_HMAC_KEY=
# OUTBOX_PROTECTED_PAYLOAD_KEY=
