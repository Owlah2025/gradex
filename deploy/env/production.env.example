# Non-secret production settings. Supply secret values through the platform's
# managed environment/secret facility; never copy populated values into Git.
APP_ENV=production
PORT=8080
PUBLIC_ORIGIN=https://gradex.example
CORS_ALLOWED_ORIGINS=https://gradex.example
CORS_ALLOW_CREDENTIALS=true
TRUSTED_PROXIES=
LOG_LEVEL=info
SERVICE_ROLE=api
READINESS_TIMEOUT=2s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=20s
STUDENT_SESSION_IDLE_EXPIRY=168h
STUDENT_SESSION_ABSOLUTE_EXPIRY=720h
INSTRUCTOR_SESSION_IDLE_EXPIRY=1h
INSTRUCTOR_SESSION_ABSOLUTE_EXPIRY=24h
ADMIN_SESSION_IDLE_EXPIRY=30m
ADMIN_SESSION_ABSOLUTE_EXPIRY=12h
GENERAL_RECENT_AUTH_WINDOW=10m
HIGHEST_RISK_RECENT_AUTH_WINDOW=5m
SESSION_STALE_USE_WINDOW=5s
REDIS_ADDR=redis.internal:6379
REDIS_TLS_ENABLED=true
REDIS_TLS_SERVER_NAME=redis.internal
# Leave blank to use the system trust store; set to a mounted private CA file when required.
REDIS_TLS_CA_CERT_FILE=
S3_ENDPOINT=https://storage.example
S3_BUCKET=gradex-private-media
S3_REGION=me-central-1
S3_USE_PATH_STYLE=false
UPLOAD_URL_EXPIRY=15m
PLAYBACK_URL_EXPIRY=5m
MAX_UPLOAD_SIZE_BYTES=5368709120
FFMPEG_BINARY_PATH=ffmpeg
FFPROBE_BINARY_PATH=ffprobe
MEDIA_PROCESSING_TIMEOUT=15m
MEDIA_OPERATING_MODE=SCANNER
TAP_ENABLED=false
TAP_ENVIRONMENT=test
TAP_ADAPTER_APPROVED=false
EMAIL_ENABLED=false
STUDENT_REGISTRATION_ENABLED=false
REGISTRATION_POLICY_SET_ID=production-registration-v1
REGISTRATION_POLICY_APPROVED=false
PASSWORD_SCREEN_MODE=unavailable
COMPROMISED_PASSWORD_ADAPTER_APPROVED=false
ANONYMOUS_SESSION_TTL=30m
VERIFICATION_TOKEN_TTL=24h
PASSWORD_RESET_TOKEN_TTL=1h
ADMISSION_RATE_LIMIT_TIMEOUT=100ms
COMPROMISED_PASSWORD_TIMEOUT=3s
OUTBOX_PROTECTED_PAYLOAD_KEY_VERSION=production-v1
AUTH_FAKE_MODE=false

# Required secrets; values intentionally blank in the committed example.
DATABASE_URL=
REDIS_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
PLAYBACK_TOKEN_SECRET=
SESSION_CSRF_KEY=
ANONYMOUS_COOKIE_SIGNING_KEY=
ANONYMOUS_CSRF_KEY=
ADMISSION_LIMITER_HMAC_KEY=
OUTBOX_PROTECTED_PAYLOAD_KEY=

# Optional provider secrets, required only when their provider is enabled.
REDIS_USERNAME=
EMAIL_API_KEY=
TAP_SECRET=
