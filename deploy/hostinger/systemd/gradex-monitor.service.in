[Unit]
Description=Gradex API, worker, email, backup, and disk monitoring check
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=@GRADEX_USER@
Group=@GRADEX_GROUP@
WorkingDirectory=@GRADEX_REPO@
ExecStart=@GRADEX_REPO@/deploy/hostinger/host.sh monitor
TimeoutStartSec=120s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gradex-monitor
