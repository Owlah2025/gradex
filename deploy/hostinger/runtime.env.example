# Copy to the host state directory as runtime.env, populate it outside Git,
# set mode 0600, and never print it in evidence.

# The deployment names its own environment. It is never inferred from the
# hostname, and it has no default, so a host that forgets to declare itself
# fails preflight instead of quietly running as staging.
#
# A managed host is never development, and validateStaffComposition in
# backend/cmd/api exempts development alone. Staging and production therefore
# share one composition contract:
#
#   both:        AUTH_FAKE_MODE=false (fixed in Compose)
#                STUDENT_REGISTRATION_ENABLED=false (fixed in Compose)
#                PASSWORD_SCREEN_MODE=adapter
#                EMAIL_ENABLED=true and EMAIL_PROVIDER=resend, with EMAIL_API_KEY
#                a non-empty SESSION_CSRF_KEY, so sessions are real
#
#   staging:     APP_ENV=staging
#                COMPROMISED_PASSWORD_ADAPTER_APPROVED may stay false
#
#   production:  APP_ENV=production
#                COMPROMISED_PASSWORD_ADAPTER_APPROVED=true
#
# The adapter is required even though public student registration stays closed:
# staff invitation and onboarding set passwords, and the API's staff composition
# refuses to build without real compromised-password screening. It is the fixed
# HIBP Pwned Passwords range endpoint over HTTPS, needing no API key and no
# additional provider credential — only the outbound access the API, worker and
# bootstrap-admin already have.
#
# The approval flag is the one genuine difference: config.go requires it only
# when the environment IsProduction(). Staging runs the same real adapter with
# the flag unset.
APP_ENV=staging
PASSWORD_SCREEN_MODE=adapter
COMPROMISED_PASSWORD_ADAPTER_APPROVED=false
COMPROMISED_PASSWORD_TIMEOUT=3s

GRADEX_RELEASE_SHA=
GRADEX_BACKEND_IMAGE=
GRADEX_FRONTEND_IMAGE=
GRADEX_PROOF_IMAGE=

STAGING_HOSTNAME=
ACME_EMAIL=
PUBLIC_ORIGIN=
LEGAL_OPERATOR_NAME=Gradex Courses
LEGAL_REGISTRATION_NUMBER=
LEGAL_REGISTERED_ADDRESS=
PRIVACY_EMAIL=ahmedhazemelmelegy11@gmail.com
SUPPORT_EMAIL=ahmedhazemelmelegy11@gmail.com
SECURITY_EMAIL=ahmedhazemelmelegy11@gmail.com

POSTGRES_DB=gradex_playwright_e2e_s12provider01
POSTGRES_PASSWORD=
DATABASE_URL=
GRADEX_E2E_ADMIN_DB_URL=
RESTORE_POSTGRES_PASSWORD=
RESTORE_DATABASE_URL=

REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS_CA_CERT_FILE_HOST=/var/lib/gradex/redis-tls/ca.crt
REDIS_TLS_SERVER_CERT_FILE_HOST=/var/lib/gradex/redis-tls/server.crt
REDIS_TLS_SERVER_KEY_FILE_HOST=/var/lib/gradex/redis-tls/server.key

# Cloudflare R2 S3 API endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Dedicated encrypted backup repository; do not reuse the application media bucket.
# Optional explicit PostgreSQL container for backup and restore deployments that
# do not use the canonical Hostinger Compose topology. The restore source resolves
# through this same value, so a deployment driven by its own Compose file stays
# recoverable without a `postgres` service in this repository's project.
GRADEX_BACKUP_POSTGRES_CONTAINER=
# Image for the standalone restore verification database. The default matches the
# PostgreSQL pin in the Hostinger Compose model. RESTORE_POSTGRES_PASSWORD above
# is required before `host.sh restore` can create that database.
GRADEX_RESTORE_POSTGRES_IMAGE=postgres:16.14-alpine
GRADEX_BACKUP_S3_ENDPOINT=
GRADEX_BACKUP_S3_BUCKET=
GRADEX_BACKUP_S3_PREFIX=gradex-production-backups
GRADEX_BACKUP_S3_REGION=auto
GRADEX_BACKUP_S3_BUCKET_LOOKUP=auto
GRADEX_BACKUP_S3_ACCESS_KEY=
GRADEX_BACKUP_S3_SECRET_KEY=
GRADEX_BACKUP_PASSWORD_FILE=/var/lib/gradex/backup-restic-password
GRADEX_BACKUP_RESTIC_BINARY=/usr/local/bin/restic
GRADEX_BACKUP_TEST_MODE=false
GRADEX_BACKUP_RETENTION_LAST=2
GRADEX_BACKUP_RETENTION_HOURLY=48
GRADEX_BACKUP_RETENTION_DAILY=14
GRADEX_BACKUP_RETENTION_WEEKLY=8
GRADEX_BACKUP_TIMEOUT_SECONDS=300

PLAYBACK_TOKEN_SECRET=
SALES_WHATSAPP_NUMBER=
SESSION_CSRF_KEY=
ANONYMOUS_COOKIE_SIGNING_KEY=
ANONYMOUS_CSRF_KEY=
ADMISSION_LIMITER_HMAC_KEY=
# Non-secret login admission controls. Concurrency=1 is the current KVM2
# benchmark baseline; capacity still requires the external 500-login run.
LOGIN_PASSWORD_VERIFY_CONCURRENCY=1
LOGIN_PASSWORD_VERIFY_QUEUE_CAPACITY=500
LOGIN_PASSWORD_VERIFY_QUEUE_WAIT=45s
LOGIN_REQUEST_TIMEOUT=60s
OUTBOX_PROTECTED_PAYLOAD_KEY_VERSION=hostinger-staging-v1
OUTBOX_PROTECTED_PAYLOAD_KEY=
EMAIL_ENABLED=true
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Gradex
EMAIL_REPLY_TO=
EMAIL_PROVIDER_TIMEOUT=10s

# Optional external monitoring destination. Keep credentials outside Git.
GRADEX_BACKUP_MAX_AGE_SECONDS=7200
GRADEX_BACKUP_MAX_FUTURE_SECONDS=300
# Canonical Hostinger Compose remains the fallback. Set all three values only
# when monitoring a separately named Compose topology such as Founder Beta.
GRADEX_MONITOR_COMPOSE_PROJECT=
GRADEX_MONITOR_WORKER_CONTAINER=
GRADEX_MONITOR_POSTGRES_CONTAINER=
# Optional when GRADEX_BACKEND_IMAGE is absent in a tooling-only runtime.
GRADEX_MONITOR_API_CONTAINER=
GRADEX_MONITOR_DISK_PATHS=
GRADEX_MONITOR_EMAIL_STALE_SECONDS=3600
GRADEX_MONITOR_DISK_WARN_PERCENT=85
GRADEX_MONITOR_DISK_CRITICAL_PERCENT=95
GRADEX_MONITOR_DISK_MIN_FREE_BYTES=5368709120
# Optional custom CA bundle for health/readiness and webhook HTTPS verification.
GRADEX_MONITOR_CA_FILE=
GRADEX_ALERT_WEBHOOK_URL=
GRADEX_ALERT_WEBHOOK_TOKEN=
# Optional monitoring-only Resend destination. Reuse EMAIL_FROM_* sender settings.
GRADEX_ALERT_RESEND_API_KEY=
GRADEX_ALERT_EMAIL_TO=
