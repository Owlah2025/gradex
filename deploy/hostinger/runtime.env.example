# Copy to the host state directory as runtime.env, populate it outside Git,
# set mode 0600, and never print it in evidence.
GRADEX_RELEASE_SHA=
GRADEX_BACKEND_IMAGE=
GRADEX_FRONTEND_IMAGE=
GRADEX_PROOF_IMAGE=

STAGING_HOSTNAME=
ACME_EMAIL=
PUBLIC_ORIGIN=
LEGAL_OPERATOR_NAME=Gradex Courses
LEGAL_REGISTRATION_NUMBER=
LEGAL_REGISTERED_ADDRESS=
PRIVACY_EMAIL=ahmedhazemelmelegy11@gmail.com
SUPPORT_EMAIL=ahmedhazemelmelegy11@gmail.com
SECURITY_EMAIL=ahmedhazemelmelegy11@gmail.com

POSTGRES_DB=gradex_playwright_e2e_s12provider01
POSTGRES_PASSWORD=
DATABASE_URL=
GRADEX_E2E_ADMIN_DB_URL=
RESTORE_POSTGRES_PASSWORD=
RESTORE_DATABASE_URL=

REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS_CA_CERT_FILE_HOST=/var/lib/gradex/redis-tls/ca.crt
REDIS_TLS_SERVER_CERT_FILE_HOST=/var/lib/gradex/redis-tls/server.crt
REDIS_TLS_SERVER_KEY_FILE_HOST=/var/lib/gradex/redis-tls/server.key

# Cloudflare R2 S3 API endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

PLAYBACK_TOKEN_SECRET=
SALES_WHATSAPP_NUMBER=
SESSION_CSRF_KEY=
ANONYMOUS_COOKIE_SIGNING_KEY=
ANONYMOUS_CSRF_KEY=
ADMISSION_LIMITER_HMAC_KEY=
# Non-secret login admission controls. Concurrency=1 is the current KVM2
# benchmark baseline; capacity still requires the external 500-login run.
LOGIN_PASSWORD_VERIFY_CONCURRENCY=1
LOGIN_PASSWORD_VERIFY_QUEUE_CAPACITY=500
LOGIN_PASSWORD_VERIFY_QUEUE_WAIT=45s
LOGIN_REQUEST_TIMEOUT=60s
OUTBOX_PROTECTED_PAYLOAD_KEY_VERSION=hostinger-staging-v1
OUTBOX_PROTECTED_PAYLOAD_KEY=
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Gradex
EMAIL_REPLY_TO=
EMAIL_PROVIDER_TIMEOUT=10s

# Optional external monitoring destination. Keep credentials outside Git.
GRADEX_BACKUP_MAX_AGE_SECONDS=7200
# Optional custom CA bundle for health/readiness and webhook HTTPS verification.
GRADEX_MONITOR_CA_FILE=
GRADEX_ALERT_WEBHOOK_URL=
GRADEX_ALERT_WEBHOOK_TOKEN=
