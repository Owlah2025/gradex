diff --git a/backend/cmd/api/schema43_compat_test.go b/backend/cmd/api/schema43_compat_test.go
new file mode 100644
index 0000000..ddc8154
--- /dev/null
+++ b/backend/cmd/api/schema43_compat_test.go
@@ -0,0 +1,16 @@
+package main
+
+import (
+	"testing"
+
+	"github.com/Owlah2025/gradex/backend/internal/db"
+)
+
+func TestRollbackBuildRequiresSchema43(t *testing.T) {
+	if got := requiredSchemaVersion(nil); got != db.AutoDeviceReplacementSchemaVersion {
+		t.Fatalf("API readiness floor = %d, want schema 43", got)
+	}
+	if db.MaxSchemaVersion != db.AutoDeviceReplacementSchemaVersion {
+		t.Fatalf("rollback build ceiling = %d, want schema 43", db.MaxSchemaVersion)
+	}
+}
diff --git a/backend/cmd/schema43-rollback-probe/main.go b/backend/cmd/schema43-rollback-probe/main.go
new file mode 100644
index 0000000..9148dcd
--- /dev/null
+++ b/backend/cmd/schema43-rollback-probe/main.go
@@ -0,0 +1,159 @@
+//go:build integration
+
+// schema43-rollback-probe exercises the previous application behavior against
+// a disposable schema-43 database populated by the current rotation code.
+package main
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"errors"
+	"fmt"
+	"os"
+	"time"
+
+	"github.com/jackc/pgx/v5/pgxpool"
+
+	"github.com/Owlah2025/gradex/backend/internal/config"
+	"github.com/Owlah2025/gradex/backend/internal/db"
+	"github.com/Owlah2025/gradex/backend/internal/identity"
+	"github.com/Owlah2025/gradex/backend/internal/outbox"
+)
+
+func main() {
+	if err := run(context.Background()); err != nil {
+		fmt.Fprintln(os.Stderr, "schema43 rollback compatibility:", err)
+		os.Exit(1)
+	}
+	fmt.Println("schema43 rollback compatibility: PASS")
+}
+
+func run(ctx context.Context) error {
+	dsn := os.Getenv("GRADEX_COMPAT_TEST_DSN")
+	accountID := os.Getenv("GRADEX_COMPAT_ACCOUNT_ID")
+	firstDigest := os.Getenv("GRADEX_COMPAT_FIRST_DIGEST")
+	evictedID := os.Getenv("GRADEX_COMPAT_EVICTED_ID")
+	newerID := os.Getenv("GRADEX_COMPAT_NEWER_ID")
+	if dsn == "" || accountID == "" || firstDigest == "" || evictedID == "" || newerID == "" {
+		return errors.New("disposable database and fixture identifiers are required")
+	}
+	pool, err := pgxpool.New(ctx, dsn)
+	if err != nil {
+		return err
+	}
+	defer pool.Close()
+	if err := db.CheckSchemaAtLeast(ctx, pool, db.AutoDeviceReplacementSchemaVersion); err != nil {
+		return fmt.Errorf("schema/readiness: %w", err)
+	}
+	var deviceReason, sessionReason string
+	if err := pool.QueryRow(ctx, `SELECT revocation_reason::text FROM identity_trusted_devices WHERE id=$1::uuid AND account_id=$2::uuid`, evictedID, accountID).Scan(&deviceReason); err != nil {
+		return err
+	}
+	if err := pool.QueryRow(ctx, `SELECT revocation_reason::text FROM sessions WHERE trusted_device_id=$1::uuid AND account_id=$2::uuid LIMIT 1`, evictedID, accountID).Scan(&sessionReason); err != nil {
+		return err
+	}
+	if deviceReason != "AUTO_REPLACED" || sessionReason != "AUTO_REPLACED" {
+		return fmt.Errorf("automatic replacement history was not preserved")
+	}
+	devices, sessions, err := services(pool)
+	if err != nil {
+		return err
+	}
+	overview, err := devices.Overview(ctx, accountID, "", time.Now().UTC())
+	if err != nil || len(overview.Devices) != 2 {
+		return fmt.Errorf("device overview: %v, count=%d", err, len(overview.Devices))
+	}
+	adminOverview, err := devices.AdminOverview(ctx, accountID, time.Now().UTC())
+	if err != nil {
+		return err
+	}
+	foundAuto := false
+	for _, device := range adminOverview.Devices {
+		if device.ID == evictedID && device.RevocationReason == "AUTO_REPLACED" {
+			foundAuto = true
+		}
+	}
+	if !foundAuto {
+		return errors.New("admin device history omitted AUTO_REPLACED")
+	}
+	grant, err := sessions.Login(ctx, identity.LoginRequest{
+		Email:                  "device-student@example.test",
+		Password:               config.NewSecret("correct device login passphrase 9"),
+		RequestID:              "rollback-compat-returning-login",
+		DeviceCredentialDigest: firstDigest,
+		UserAgent:              "Chrome/120.0 (Windows)",
+	})
+	if err != nil || grant.Device == nil || grant.Device.TrustState != identity.DeviceTrustEstablished {
+		return fmt.Errorf("returning Student login: %v", err)
+	}
+	view, err := sessions.Resolve(ctx, identity.SessionResolutionRequest{
+		CredentialDigest:       identity.DigestToken(grant.Credential.Expose()),
+		DeviceCredentialDigest: firstDigest, UseKind: identity.UseReadOnly,
+		RequestID: "rollback-compat-resolve",
+	})
+	if err != nil || view.Session.DeviceTrust != identity.DeviceTrustEstablished {
+		return fmt.Errorf("session resolve: %v", err)
+	}
+	principal := identity.Principal{AccountID: accountID, Role: identity.RoleStudent,
+		Status: identity.StatusActive, CredentialState: identity.CredentialActive}
+	if !identity.AuthorizeSessionDevice(principal, view.Session.DeviceTrust, identity.CapLearningAccess).Allowed {
+		return errors.New("protected learning authorization refused trusted session")
+	}
+	if err := devices.Remove(ctx, identity.RemoveRequest{
+		AccountID: accountID, DeviceID: newerID, RequestID: "rollback-compat-manual-remove",
+	}); err != nil {
+		return fmt.Errorf("manual device removal: %w", err)
+	}
+	overview, err = devices.Overview(ctx, accountID, grant.Device.DeviceID, time.Now().UTC())
+	if err != nil || len(overview.Devices) != 1 {
+		return fmt.Errorf("device overview after removal: %v", err)
+	}
+	_, incomingDigest, err := identity.NewOpaqueCredential()
+	if err != nil {
+		return err
+	}
+	pending, err := sessions.Login(ctx, identity.LoginRequest{
+		Email:                  "device-student@example.test",
+		Password:               config.NewSecret("correct device login passphrase 9"),
+		RequestID:              "rollback-compat-previous-login",
+		DeviceCredentialDigest: incomingDigest,
+		UserAgent:              "Firefox/121.0 (Macintosh)",
+	})
+	if err != nil || pending.Device == nil || pending.Device.Admission != identity.AdmitNewDeviceWithSlot ||
+		pending.Device.Challenge == nil || pending.Session.DeviceTrust != identity.DeviceTrustPending {
+		return fmt.Errorf("previous login behavior was not restored: %v", err)
+	}
+	return nil
+}
+
+func services(pool *pgxpool.Pool) (*identity.DeviceService, *identity.SessionRepository, error) {
+	cfg, err := config.LoadFrom(config.MapLookup(map[string]string{
+		"APP_ENV": "development", "REDIS_ADDR": "localhost:6379",
+		"S3_ENDPOINT": "http://localhost:9000", "S3_BUCKET": "gradex-test",
+	}), config.MapSecretResolver{
+		"DATABASE_URL": "postgres://unused", "S3_ACCESS_KEY": "a",
+		"S3_SECRET_KEY": "b", "PLAYBACK_TOKEN_SECRET": "c",
+	})
+	if err != nil {
+		return nil, nil, err
+	}
+	writer, err := outbox.NewWriter("v1", bytes.Repeat([]byte{0x51}, 32))
+	if err != nil {
+		return nil, nil, err
+	}
+	devices, err := identity.NewDeviceService(identity.DeviceServiceOptions{
+		Pool: pool, Outbox: writer,
+		Policy: identity.DevicePolicy{TrustedDeviceLimit: 2, ReplacementCooldown: 24 * time.Hour},
+		Pepper: config.NewSecret(string(bytes.Repeat([]byte{0x71}, 32))),
+		OTPTTL: 10 * time.Minute, Now: time.Now, Random: rand.Reader,
+	})
+	if err != nil {
+		return nil, nil, err
+	}
+	sessions, err := identity.NewSessionRepository(identity.SessionRepositoryOptions{
+		Pool: pool, Settings: cfg.Sessions(), CSRFKey: bytes.Repeat([]byte{0x61}, 32),
+		Now: time.Now, Devices: devices,
+	})
+	return devices, sessions, err
+}
